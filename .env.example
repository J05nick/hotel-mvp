# =============================================================================
# Hotel MVP — environment configuration (12-Factor App, factor III: Config)
# Copy to `.env` and adjust. Never commit `.env`.
# =============================================================================

# --- Runtime ------------------------------------------------------------------
# development | staging | production
ENVIRONMENT=development
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
API_PORT=8000

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_USER=hotel
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=hotel
# Host port published by docker compose
POSTGRES_PORT=5432
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Redis --------------------------------------------------------------------
# Logical DB split: 0 = locks/cache/pub-sub, 1 = Celery broker, 2 = Celery results
REDIS_PORT=6379

# --- Booking domain -----------------------------------------------------------
# Redis "cart" lock TTL (5 minutes)
BOOKING_HOLD_TTL_SECONDS=300

# --- HTTP ---------------------------------------------------------------------
# Origins allowed to call this API (the Next.js app lives in the
# hotel-mvp-frontend repository). JSON list or comma-separated.
CORS_ORIGINS=["http://localhost:3000"]
