# Copy to `.env` for local runs (docker compose sets its own values).
DATABASE_URL=postgresql+psycopg://hotel:hotel@localhost:5432/hotel
# How long a "hold" (the reservation cart) blocks a time range.
BOOKING_HOLD_TTL_SECONDS=300
# How often the in-process sweeper completes finished stays and expires lapsed holds (0 = off).
HOUSEKEEPING_INTERVAL_SECONDS=60
# Insert a few demo rooms at startup when the rooms table is empty.
SEED_DEMO_DATA=true
# Origins allowed to call the API and to open the WebSocket (JSON list or comma-separated).
CORS_ORIGINS=["http://localhost:3000"]
